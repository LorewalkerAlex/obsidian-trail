{
  "name": "obsidian-trail",
  "version": "0.0.1",
  "private": true,
  "description": "A Markdown-first personal project and task management plugin for Obsidian.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:rebuild": "tsc --noEmit -p plugin-rebuild/tsconfig.json",
    "build": "npm run typecheck:rebuild && node esbuild.config.mjs production",
    "build:diagnostics": "npm run typecheck:rebuild && node esbuild.config.mjs diagnostics",
    "test": "vitest",
    "test:run": "vitest run --reporter=dot",
    "test:run:verbose": "vitest run",
    "test:run:rebuild": "vitest run --config vitest.rebuild.config.ts --reporter=dot",
    "lint": "eslint .",
    "lint:rebuild": "eslint plugin-rebuild/src vitest.rebuild.config.ts",
    "check:rebuild": "npm run lint:rebuild && npm run typecheck:rebuild && npm run test:run:rebuild",
    "check": "npm run lint && npm run test:run && npm run typecheck:rebuild && npm run test:run:rebuild && npm run build"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
